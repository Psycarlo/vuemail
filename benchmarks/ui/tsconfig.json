{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "tsconfig/base.json",
  "include": ["src"],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    "target": "esnext",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node",
    "noEmit": true,
    "types": ["node"]
  }
}
