{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Vuemail",
  "colors": {
    "primary": "#42B883",
    "light": "#42D392",
    "dark": "#0B6E4F"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "vesper"
      }
    }
  },
  "contextual": {
    "options": [
      "copy",
      {
        "title": "llms-full.txt",
        "description": "View all docs as Markdown for LLMs",
        "icon": "markdown",
        "href": "https://vuemail.dev/docs/llms-full.txt"
      },
      "chatgpt",
      "claude"
    ]
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Primitives",
        "icon": "cubes",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "introduction",
              "changelog",
              "roadmap",
              "cli",
              "deployment"
            ]
          },
          {
            "group": "Getting Started",
            "pages": [
              "getting-started/automatic-setup",
              "getting-started/manual-setup",
              "getting-started/nuxt",
              {
                "group": "Monorepo Setup",
                "icon": "diagram-project",
                "pages": [
                  "getting-started/monorepo-setup/npm",
                  "getting-started/monorepo-setup/pnpm",
                  "getting-started/monorepo-setup/yarn",
                  "getting-started/monorepo-setup/bun"
                ]
              },
              "getting-started/migrating-to-vuemail",
              "getting-started/updating-vuemail"
            ]
          },
          {
            "group": "Guides",
            "pages": [
