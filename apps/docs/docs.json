    "global": {
      "anchors": [
        {
          "anchor": "Components",
          "href": "https://vuemail.dev/components",
          "icon": "grid-2-plus"
        },
        {
          "anchor": "Templates",
          "href": "https://demo.vuemail.dev/preview/Community/notifications/vercel-invite-user",
          "icon": "arrow-pointer"
        }
      ]
