  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "background": {
    "image": "/images/background.svg",
    "color": {
      "light": "#FFFFFF",
      "dark": "#111111"
    }
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/psycarlo/vuemail"
    }
