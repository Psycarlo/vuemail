                  "guides/internationalization/vue-i18n",
                  "guides/internationalization/messages-as-props"
                ]
              },
              "guides/vite-plugins",
              "guides/vite"
            ]
          },
          {
            "group": "Components",
            "pages": [
              "components/html",
              "components/head",
              "components/body",
              "components/button",
              "components/container",
              "components/code-block",
              "components/code-inline",
              "components/column",
