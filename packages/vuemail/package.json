{
  "name": "vuemail",
  "version": "0.1.0",
  "description": "Build and send emails using Vue. Components, rendering and a live preview of your emails right in your browser.",
  "bin": {
    "email": "./dist/cli/index.mjs",
    "vuemail": "./dist/cli/index.mjs"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch src",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/psycarlo/vuemail.git",
    "directory": "packages/vuemail"
  },
  "homepage": "https://vuemail.dev",
  "keywords": [
    "vue",
    "email",
    "nuxt",
    "tailwind"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@vuemail/render": "workspace:*",
    "commander": "catalog:",
    "conf": "^15.0.2",
    "css-tree": "3.2.1",
    "entities": "^7.0.1",
    "html5parser": "^3.0.0",
    "log-symbols": "^7.0.0",
    "marked": "^15.0.12",
    "nypm": "^0.6.6",
    "prismjs": "^1.30.0",
    "prompts": "2.4.2",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/css-tree": "catalog:",
    "@types/prismjs": "1.26.6",
    "@types/prompts": "2.4.9",
    "@vitejs/plugin-vue": "catalog:",
    "tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
